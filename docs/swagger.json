{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Test API",
    "description": "Документация API"
  },
  "host": "0.0.0.0:3000",
  "basePath": "/api/v1",
  "tags": [
    { "name": "Auth", "description": "Авторизация и управление доступом" },
    { "name": "Users", "description": "Работа с профилями пользователей" }
  ],
  "schemes": ["http"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Введите токен в формате: Bearer <AccessToken>"
    }
  },
  "paths": {
    "/auth/sign-up": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Регистрация нового пользователя",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": { "$ref": "#/definitions/UserCreate" }
          }
        ],
        "responses": {
          "201": {"description": "Пользователь успешно создан","schema": {"$ref": "#/definitions/IUser"}},
          "400": {"description": "Ошибка валидации (Joi)","schema": {"$ref": "#/definitions/Error"}}
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": ["Auth"],
        "summary": "Вход в систему",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": {
              "$ref": "#/definitions/LoginDto"
            }
          }
        ],
        "responses": {
          "201": {"description": "Успешный вход", "schema": {"$ref": "#/definitions/AuthResponse"}},
          "401": {"description": "Неверный логин или пароль","schema": {"$ref": "#/definitions/Error"}},
          "404": {"description": "Пользователь не найден","schema": {"$ref": "#/definitions/Error"}}
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Обновление пары токенов",
        "description": "Требуется валидный Refresh Token",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Объект, содержащий Refresh токен",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "refreshToken"
              ],
              "properties": {"refreshToken": {"type": "string","example": "eyJhbGciOiJIUzI1Ni..."}}
            }
          }
        ],
        "responses": {
          "201": {"description": "Токены обновлены","schema": {"$ref": "#/definitions/TokenPair"}},
          "401": {"description": "Refresh Token невалиден, отсутствует или просрочен","schema": {"$ref": "#/definitions/Error"}}
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Выход из текущей сессии",
        "description": "Удаляет Refresh токен данного пользователя из базы данных.",
        "security": [ {"BearerAuth": []}],
        "responses": {
          "204": { "description": "Успешно" },
          "401": { "description": "Refresh токен недействителен или отозван" }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Выход со всех устройств",
        "description": "Удаляет ВСЕ сессии (пары токенов) данного пользователя из базы данных.",
        "security": [{"BearerAuth": []}],
        "responses": {
          "204": {"description": "Все сессии успешно завершены."},
          "401": {"description": "Ошибка авторизации","schema": {"$ref": "#/definitions/Error" }}
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Запрос на сброс пароля (отправка email)",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {"description": "Письмо для замены пароля отправлено"},
          "404": {"description": "Пользователя с таким email не существует"}
        }
      },
      "put": {
        "tags": ["Auth"],
        "summary": "Установка нового пароля",
        "description": "Используется после получения письма для сброса пароля. Метод обновляет пароль и завершает все текущие сессии пользователя.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResetPasswordSet"
            }
          }
        ],
        "responses": {
          "204": {"description": "Пароль успешно изменен. Все активные сессии пользователя завершены."},
          "401": {"description": "Невалидный или просроченный Action Token","schema": {"$ref": "#/definitions/Error"}},
          "400": {"description": "Ошибка валидации данных", "schema": {"$ref": "#/definitions/Error"}}
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Смена пароля (для авторизованного пользователя)",
        "description": "Позволяет сменить пароль, проверив текущую сессию и валидность новых данных.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChangePasswordDto"
            }
          }
        ],
        "responses": {
          "204": { "description": "Пароль успешно изменен." },
          "400": { "description": "Ошибка валидации (неверный формат данных)","schema": { "$ref": "#/definitions/Error" }},
          "401": { "description": "Токен отсутствует или недействителен","schema": {"$ref": "#/definitions/Error" }},
          "404": { "description": "Пользователь не найден","schema": {"$ref": "#/definitions/Error" }},
          "409": { "description": "Вы не можете менять пароль чаще, чем раз в 180 дней","schema": {"$ref": "#/definitions/Error" }}
        }
      }
    },
    "/auth/verify": {
      "patch": {
        "tags": ["Auth"],
        "summary": "Подтверждение адреса электронной почты",
        "description": "Используется для активации аккаунта через ссылку из письма.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "token"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "description": "Специальный Verify Email токен из письма",
                  "example": "v_email_eyJhbGciOiJIUzI1Ni..."
                }
              }
            }
          }
        ],
        "responses": {
          "204": {"description": "Почта успешно подтверждена. Аккаунт активирован."},
          "400": {"description": "Токен не предоставлен","schema": {"$ref": "#/definitions/Error" }},
          "401": {"description": "Токен недействителен, просрочен или уже использован", "schema": {"$ref": "#/definitions/Error"}}
        }
      }
    },
    "/users/": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получение списка пользователей",
        "description": "Возвращает список только верифицированных пользователей. Поддерживает поиск по имени, сортировку и пагинацию.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Номер страницы",
            "type": "integer",
            "default": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Количество пользователей на странице",
            "type": "integer",
            "default": 10
          },
          {
            "name": "search",
            "in": "query",
            "description": "Поиск по имени (регистронезависимый)",
            "type": "string"
          },
          {
            "name": "orderBy",
            "in": "query",
            "description": "По какому полю сортировать",
            "type": "string",
            "enum": [
              "name",
              "createdAt"
            ]
          },
          {
            "name": "order",
            "in": "query",
            "description": "Направление сортировки",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Успешное получение списка",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/IUser"
                  }
                },
                "total": {
                  "type": "integer",
                  "example": 100
                },
                "page": {
                  "type": "integer",
                  "example": 1
                },
                "limit": {
                  "type": "integer",
                  "example": 10
                }
              }
            }
          },
          "400": {"description": "Ошибка валидации параметров запроса", "schema": { "$ref": "#/definitions/Error" }}
        }
      }
      },
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Получить данные своего профиля",
        "description": "Возвращает данные пользователя, которому принадлежит Access токен.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {"description": "Данные профиля", "schema": {"$ref": "#/definitions/UserResponse" }},
          "401": { "description": "Ошибка авторизации: токен отсутствует или невалиден", "schema": { "$ref": "#/definitions/Error" }},
          "404": { "description": "Пользователь не найден", "schema": { "$ref": "#/definitions/Error" }}
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Обновить свой профиль",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": {
              "$ref": "#/definitions/UserUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные профиля успешно получены",
            "schema": {
              "$ref": "#/definitions/IUser"
            }
          },
          "401": { "description": "Ошибка авторизации: токен отсутствует или невалиден", "schema": { "$ref": "#/definitions/Error" }},
          "404": {
            "description": "Пользователь не найден в базе",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Удалить свой аккаунт",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {"description": "Аккаунт удален" },
          "401": { "description": "Ошибка авторизации: токен отсутствует или невалиден", "schema": { "$ref": "#/definitions/Error" }},
          "404": { "description": "Пользователь не найден", "schema": { "$ref": "#/definitions/Error" }}
        }

      }
    },
    "/users/me/avatar": {
        "post": {
          "tags": ["Users"],
          "summary": "Загрузить или обновить аватар",
          "security": [{"BearerAuth": []}],
          "consumes": [ "multipart/form-data"],
          "parameters": [
            {
              "name": "avatar",
              "in": "formData",
              "type": "file",
              "required": true
            }
          ],
          "responses": {
            "201": {"description": "Аватар обновлен","schema": {"$ref": "#/definitions/UserResponse" }},
            "400": { "description": "Ошибка: Файл отсутствует, формат файла или размер слишком большой", "schema": { "$ref": "#/definitions/Error" }},
            "401": { "description": "Ошибка авторизации: токен отсутствует или невалиден", "schema": { "$ref": "#/definitions/Error" }},
            "404": { "description": "Пользователь не найден", "schema": { "$ref": "#/definitions/Error" }}
          }
        },
      "delete": {
        "tags": ["Users"],
        "summary": "Удалить текущий аватар",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {"description": "Аватар успешно удален", "schema": { "$ref": "#/definitions/UserResponse" } },
          "401": { "description": "Не авторизован", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
      },
    "/users/{userId}": {
        "get": {
          "tags": ["Users"],
          "summary": "Получить пользователя по ID",
          "parameters": [
            {
              "name": "userId",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "MongoDB ObjectId"
            }
          ],
          "responses": {
            "200": {"description": "Пользователь найден","schema": {"$ref": "#/definitions/UserResponse" }},
            "400": {"description": "Некорректный формат ID (Invalid Object ID)","schema": { "$ref": "#/definitions/Error" }},
            "404": {"description": "Пользователь не найден","schema": { "$ref": "#/definitions/Error" }}
          }
        }
      }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "example": "Invalid Object ID" },
        "status": { "type": "integer", "description": "HTTP код ошибки" }
      }
    },
    "IUser": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "integer" },
        "avatar?": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isVerified": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "phone?": { "type": "string" },
        "lastVisit": { "type": "Date" },
        "createdAt": { "type": "Date" },
        "updatedAt": { "type": "Date" }
      }
    },
    "UserResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "integer" },
        "avatar": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "UserCreate": {
      "type": "object",
      "required": ["name", "email", "password", "age"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 30 },
        "email": { "type": "string" },
        "password": { "type": "string", "minLength": 6 },
        "age": { "type": "integer", "minimum": 1, "maximum": 120 },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "age": { "type": "integer" }
      }
    },
    "LoginDto": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "ChangePasswordDto": {
      "type": "object",
      "required": ["oldPassword", "password"],
      "properties": {
        "oldPassword": { "type": "string" },
        "password": { "type": "string", "minLength": 8, "maxLength": 30, "description": "Новый пароль" }
      }
    },
    "ResetPasswordSet": {
      "type": "object",
      "required": ["password", "token"],
      "properties": {
        "password": { "type": "string" },
        "token": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "type": "string" }
      }
    },
    "UserListResponse": {
      "type": "object",
      "properties": {
        "data": { "type": "array", "items": { "$ref": "#/definitions/UserResponse" } },
        "total": { "type": "integer" },
        "page": { "type": "integer" }
      }
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/IUser"
        },"tokens": {
          "$ref": "#/definitions/TokenPair"
        }
              }
    }
  }

}