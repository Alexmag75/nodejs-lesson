{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Bolgrad Lyceum API",
    "description": "Полная документация API: Пользователи, Профили и Авторизация с обработкой ошибок"
  },
  "host": "localhost:5000",
  "basePath": "/api/v1",
  "tags": [
    { "name": "Auth", "description": "Вход, регистрация и управление доступом" },
    { "name": "User", "description": "Работа с данными пользователей" }
  ],
  "schemes": ["http"],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Введите токен в формате: Bearer <token>"
    }
  },
  "paths": {
    "/auth/sign-up": {
      "post": {
        "tags": ["Auth"],
        "summary": "Регистрация пользователя",
        "parameters": [{ "in": "body", "name": "body", "schema": { "$ref": "#/definitions/UserCreate" } }],
        "responses": { "201": { "description": "Создано" } }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": ["Auth"],
        "summary": "Вход в систему",
        "parameters": [{ "in": "body", "name": "body", "schema": { "$ref": "#/definitions/LoginDto" } }],
        "responses": {
          "200": { "description": "Успешно", "schema": { "$ref": "#/definitions/TokenPair" } },
          "401": { "description": "Неверные учетные данные (пароль)", "schema": { "$ref": "#/definitions/Error" } },
          "404": { "description": "User не найден (email)", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Обновление токенов",
        "responses": { "200": { "description": "Новые токены", "schema": { "$ref": "#/definitions/TokenPair" } } }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Выход",
        "security": [{ "BearerAuth": [] }],
        "responses": { "204": { "description": "Выход выполнен" } }
      }
    },
    "/auth/logout-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Выход со всех устройств",
        "security": [{ "BearerAuth": [] }],
        "responses": { "204": { "description": "Все сессии завершены" } }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Запрос на восстановление пароля",
        "parameters": [{ "in": "body", "name": "body", "schema": { "type": "object", "properties": { "email": { "type": "string" } } } }],
        "responses": { "200": { "description": "Письмо отправлено" } }
      },
      "put": {
        "tags": ["Auth"],
        "summary": "Установка нового пароля",
        "parameters": [{ "in": "body", "name": "body", "schema": { "type": "object", "properties": { "password": { "type": "string" } } } }],
        "responses": { "200": { "description": "Пароль изменен" } }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Смена пароля",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "body", "name": "body", "schema": { "$ref": "#/definitions/ChangePasswordDto" } }],
        "responses": { "200": { "description": "Пароль обновлен" } }
      }
    },
    "/auth/verify": {
      "patch": {
        "tags": ["Auth"],
        "summary": "Подтверждение почты",
        "responses": { "200": { "description": "Почта подтверждена" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["User"],
        "summary": "Список всех пользователей",
        "parameters": [
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "limit", "in": "query", "type": "integer" },
          { "name": "search", "in": "query", "type": "string" },
          { "name": "orderBy", "in": "query", "type": "string" },
          { "name": "order", "in": "query", "type": "string", "enum": ["asc", "desc"] }
        ],
        "responses": { "200": { "description": "Успешно", "schema": { "$ref": "#/definitions/UserListResponse" } } }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["User"],
        "summary": "Мой профиль",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Данные профиля", "schema": { "$ref": "#/definitions/User" } } }
      },
      "put": {
        "tags": ["User"],
        "summary": "Обновить профиль",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "body", "name": "body", "schema": { "$ref": "#/definitions/UserUpdate" } }],
        "responses": { "200": { "description": "Обновлено" } }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Удалить аккаунт",
        "security": [{ "BearerAuth": [] }],
        "responses": { "204": { "description": "Удалено" } }
      }
    },
    "/users/me/avatar": {
      "post": {
        "tags": ["User"],
        "summary": "Загрузить аватар",
        "security": [{ "BearerAuth": [] }],
        "consumes": ["multipart/form-data"],
        "parameters": [{ "name": "avatar", "in": "formData", "type": "file", "required": true }],
        "responses": { "200": { "description": "Аватар загружен" } }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "example": "User не найден" },
        "status": { "type": "integer", "example": 404 }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "UserCreate": {
      "type": "object",
      "required": ["name", "email", "password"],
      "properties": {
        "name": { "type": "string", "example": "Ivan" },
        "email": { "type": "string", "example": "test@test.com" },
        "password": { "type": "string", "example": "Pass12345" }
      }
    },
    "LoginDto": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "example": "test@test.com" },
        "password": { "type": "string", "example": "Pass12345" }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "type": "string" }
      }
    },
    "ChangePasswordDto": {
      "type": "object",
      "required": ["oldPassword", "newPassword"],
      "properties": {
        "oldPassword": { "type": "string" },
        "newPassword": { "type": "string" }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "UserListResponse": {
      "type": "object",
      "properties": {
        "data": { "type": "array", "items": { "$ref": "#/definitions/User" } },
        "total": { "type": "integer" }
      }
    }
  }
}